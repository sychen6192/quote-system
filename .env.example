# ============================================================
# Quote System — environment configuration
# Copy this file to .env and fill in your values.
# Every variable except DATABASE_URL is optional: sensible
# placeholder defaults are used when a value is missing.
# Most company, quote and email details can also be edited in the
# app's Settings page, which takes precedence over these values.
#
# Do NOT wrap values in quotes. This file is loaded both by
# Next.js (dev) and by `docker run --env-file` (deploy); the
# latter keeps quotes literally. Write `KEY=value`, not
# `KEY="value"`. (The app also strips stray quotes defensively.)
# ============================================================

# --- Database (required) ---
# Matches the postgres service in docker-compose.yaml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quote-system
# Max connections in the app's pool (default 10). Keep it below the
# database's max_connections when running several app instances.
DB_POOL_MAX=10
# The app applies pending database migrations on every start (safe to repeat,
# and serialised with a database lock). Set to true only if you run
# `npm run db:migrate` yourself before starting the app.
SKIP_DB_MIGRATIONS=

# --- Access control (optional, recommended) ---
# Password everyone uses to sign in. Leave empty to disable sign-in, e.g. on a
# trusted single-user machine. Changing it signs everyone out.
APP_PASSWORD=
# Random secret (at least 32 characters) that signs session cookies.
# Generate one with: openssl rand -hex 32
# If empty, a key is derived from APP_PASSWORD and a warning is logged.
AUTH_SECRET=

# --- Region ---
# IANA time zone that decides "today" for quote dates, numbering and expiry.
# Falls back to TZ, then Asia/Taipei.
APP_TIMEZONE=Asia/Taipei

# --- Company identity (shown on quote page, PDF, and email) ---
# Default when unset: "Your Company" (and the row is hidden for empty optional fields)
COMPANY_NAME=Acme Inc.
# Local-language name shown under the main name (e.g. Chinese name). Hidden when empty.
COMPANY_NAME_LOCAL=
COMPANY_ADDRESS=123 Example Street, Example City
# VAT / tax registration number. Hidden when empty.
COMPANY_VAT_NUMBER=
COMPANY_EMAIL=contact@example.com
COMPANY_PHONE=+1 555 0100

# --- Bank / payment details (optional) ---
# When all three are empty the whole "Payment Details" section is hidden.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# --- Email sending (optional, via https://resend.com) ---
# Leave RESEND_API_KEY unset to disable the "Send Email" button.
RESEND_API_KEY=
# Sender display name. Defaults to COMPANY_NAME.
MAIL_SENDER_NAME=
# Must be a domain verified in Resend. Defaults to onboarding@resend.dev (test only).
MAIL_SENDER_EMAIL=
# Comma-separated CC list, e.g. a@example.com,b@example.com
MAIL_CC_EMAILS=

# --- Money & locale ---
# ISO 4217 currency code used everywhere amounts are displayed.
CURRENCY=TWD
# Intl locale used to format money (independent of the UI language).
CURRENCY_LOCALE=zh-TW
# Default tax rate (%) pre-filled on new quotes. 0-100.
DEFAULT_TAX_RATE=5

# --- Regional features (optional) ---
# Enable the Taiwan 統編 (VAT number) lookup button in the quote form, which
# queries the public GCIS open-data API. Leave empty to disable. Taiwan-only.
TW_VAT_LOOKUP=
