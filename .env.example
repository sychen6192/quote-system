# ============================================================
# Quote System: environment configuration (development and custom deployments)
#
# Copy to .env and adjust. Only DATABASE_URL is required.
# For the Docker install, use deploy/.env.example instead (install.sh fills it in).
#
# Precedence, field by field: Settings page (database) > these variables >
# built-in defaults. Most company, quote and email details are easier to edit
# on the Settings page; the variables below pre-fill them.
#
# Write KEY=value without quotes. This file is read by Next.js (dev) and by
# `docker run --env-file`, which keeps quotes literally. (The app strips one
# layer of stray quotes defensively.) Multi-line texts use \n.
# ============================================================

# --- Database (required) ---
# Matches the postgres service in docker-compose.yaml (`docker compose up -d postgres`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quote-system
# Max connections in the app's pool (default 10, 1-100). Keep the total below
# the database's max_connections when running several app instances.
DB_POOL_MAX=10
# The app applies pending database migrations on every start (safe to repeat,
# serialised with a database lock). Set to true only if you run
# `npm run db:migrate` yourself before starting the app.
SKIP_DB_MIGRATIONS=

# --- Sign-in (optional, recommended) ---
# Shared password everyone uses to sign in. Empty = sign-in off (trusted
# single-user machine or LAN only). Changing it signs everyone out.
APP_PASSWORD=
# Random secret (at least 32 characters) that signs session cookies.
# Generate one with: openssl rand -hex 32
# If empty, a key is derived from APP_PASSWORD and a warning is logged.
AUTH_SECRET=

# --- Installed app ---
# Name of the installed app (home screen, task bar). Defaults to the company
# name, then "Quote System". Changing it later makes browsers ask the user.
APP_NAME=
# Emergency switch: true serves a service worker that clears its caches and
# uninstalls itself on every device that opens the app. Default off.
PWA_DISABLE_SW=

# --- Region ---
# IANA time zone that decides "today" for quote dates, numbering and expiry.
# Falls back to TZ, then Asia/Taipei.
APP_TIMEZONE=Asia/Taipei

# --- Company identity (quote page, PDF, email) ---
# Default name: "Your Company". Empty optional fields are hidden.
COMPANY_NAME=Acme Inc.
# Local-language name shown under the main name (e.g. the Chinese name).
COMPANY_NAME_LOCAL=
COMPANY_ADDRESS=123 Example Street, Example City
# VAT / tax registration number (統一編號).
COMPANY_VAT_NUMBER=
COMPANY_EMAIL=contact@example.com
COMPANY_PHONE=+1 555 0100
# http(s) URL, or a bare domain such as example.com.
COMPANY_WEBSITE=

# --- Bank / payment details (optional) ---
# When all four are empty the "Payment details" block is hidden.
BANK_NAME=
BANK_CODE=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# --- Quotes ---
# Quote number pattern. Tokens: {YYYY} {YY} {ROC} (民國年) {MM} {DD} and exactly
# one {SEQ} or {SEQ:n} (zero-padded to n digits). Default QT-{YYYY}{MM}{DD}-{SEQ:3}.
QUOTE_NUMBER_PATTERN=
# Days a new quote stays valid (1-365, default 30).
QUOTE_VALIDITY_DAYS=
# Default tax rate (%) pre-filled on new quotes, 0-100 (default 5).
DEFAULT_TAX_RATE=5
# Default notes and terms for new quotes (use \n for line breaks).
DEFAULT_NOTES=
DEFAULT_TERMS=

# --- Money ---
# ISO 4217 currency code used everywhere amounts are displayed (default TWD).
CURRENCY=TWD
# Intl locale used to format money, independent of the UI language (default zh-TW).
CURRENCY_LOCALE=zh-TW

# --- Appearance ---
# Brand colour (#RRGGBB) for buttons, the PDF accent and the installed app.
# Default #1D4ED8.
BRAND_COLOR=

# --- Email sending (optional, via https://resend.com) ---
# Without RESEND_API_KEY the Send button is disabled. The key is only ever read
# from the environment (never stored in the database or sent to browsers).
RESEND_API_KEY=
# Sender display name. Defaults to the company name.
MAIL_SENDER_NAME=
# Must be on a domain verified in Resend. Default onboarding@resend.dev (testing only).
MAIL_SENDER_EMAIL=
# Comma-separated CC list, e.g. a@example.com,b@example.com
MAIL_CC_EMAILS=
# Where customer replies go, if not the sender address.
MAIL_REPLY_TO=

# --- Regional features (optional) ---
# true = show the Taiwan 統編 (VAT number) lookup button in the quote form,
# which queries the public GCIS open-data API.
TW_VAT_LOOKUP=

# --- Development ---
# Register the service worker under `npm run dev` too (normally production
# builds only). Read at build time.
# NEXT_PUBLIC_ENABLE_SW=1
