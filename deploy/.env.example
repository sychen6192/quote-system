# Quote System settings for docker compose. install.sh creates .env from this
# file and fills in the secrets. Company details, logo, quote numbering, email
# sender and currency are easier to set on the app's Settings page, so they
# are optional here. Write KEY=value without quotes.

# ---- Required -----------------------------------------------------------------
# Database password, letters and digits only (it goes into a URL).
# Generate one with: openssl rand -hex 24
# The database keeps its first password: never change this after the first start
# (docs/deploy/backup.md explains how to rotate it).
POSTGRES_PASSWORD=

# ---- Sign-in ------------------------------------------------------------------
# Shared password for the app. Leave empty to turn sign-in off (trusted LAN only).
# Changing it signs everyone out.
APP_PASSWORD=
# Random secret for session cookies, at least 32 characters (openssl rand -hex 32).
AUTH_SECRET=

# ---- Version ------------------------------------------------------------------
# Image tag to run: an exact release (1.0.0), a minor line (1.0) or "latest".
QUOTE_VERSION=latest

# ---- Network ------------------------------------------------------------------
# Host port and address for plain HTTP. Use APP_BIND=127.0.0.1 with the https
# profile so only Caddy is reachable from other machines.
APP_PORT=3000
APP_BIND=0.0.0.0

# HTTPS (docker compose --profile https up -d), needed to install the app on phones.
# SITE_ADDRESS: your domain (public certificate) or localhost / an IP / *.local
# (Caddy's local CA). CADDY_TLS="tls internal" forces the local CA for other names.
SITE_ADDRESS=localhost
CADDY_TLS=
HTTP_PORT=80
HTTPS_PORT=443

# Start optional services with the plain commands too, e.g. https,backup
COMPOSE_PROFILES=

# ---- Backups (docker compose --profile backup up -d) ----------------------------
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# ---- Region -------------------------------------------------------------------
# Decides "today" for quote dates, numbering and expiry.
APP_TIMEZONE=Asia/Taipei

# ---- Email (optional) ------------------------------------------------------------
# Resend API key (https://resend.com). The key is only read from here; sender
# name, address and CC are set on the Settings page.
RESEND_API_KEY=

# ---- Optional defaults ------------------------------------------------------------
# Anything saved on the Settings page wins over these. Uncomment to pre-fill.
# APP_NAME=Quotes
# COMPANY_NAME=Acme Inc.
# COMPANY_NAME_LOCAL=
# COMPANY_ADDRESS=
# COMPANY_VAT_NUMBER=
# COMPANY_EMAIL=
# COMPANY_PHONE=
# COMPANY_WEBSITE=
# BANK_NAME=
# BANK_CODE=
# BANK_ACCOUNT_NAME=
# BANK_ACCOUNT_NUMBER=
# CURRENCY=TWD
# CURRENCY_LOCALE=zh-TW
# DEFAULT_TAX_RATE=5
# QUOTE_NUMBER_PATTERN=QT-{YYYY}{MM}{DD}-{SEQ:3}
# QUOTE_VALIDITY_DAYS=30
# DEFAULT_NOTES=
# DEFAULT_TERMS=
# BRAND_COLOR=#1D4ED8
# MAIL_SENDER_NAME=
# MAIL_SENDER_EMAIL=
# MAIL_CC_EMAILS=
# MAIL_REPLY_TO=
# TW_VAT_LOOKUP=true

# ---- Emergency ----------------------------------------------------------------------
# true makes the installed app's service worker clear its caches and remove
# itself on every device (if a broken update ever gets stuck). Default off.
# PWA_DISABLE_SW=true
